<?xml version="1.0"?>
<robot name="patrol_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Degistirilebilir robot boyutlari (metre) -->
  <xacro:property name="body_length" value="0.30"/>
  <xacro:property name="body_width" value="0.22"/>
  <xacro:property name="body_height" value="0.10"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <!-- Tekerlek merkezleri arasi mesafe: govde genisligi + tekerlek genisligi + 5 mm bosluk -->
  <xacro:property name="wheel_separation" value="0.26"/>

  <xacro:property name="caster_radius" value="0.025"/>

  <!-- Ana govde. Atalet (kutu): ixx=m/12*(w^2+h^2), iyy=m/12*(l^2+h^2), izz=m/12*(l^2+w^2) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0243" ixy="0.0" ixz="0.0"
               iyy="0.0417" iyz="0.0" izz="0.0577"/>
    </inertial>
  </link>

  <!-- Sol tekerlek. Atalet (silindir, dönme ekseni Y): iyy=m*r^2/2, ixx=izz=m/12*(3*r^2+h^2) -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021" ixy="0.0" ixz="0.0"
               iyy="0.000375" iyz="0.0" izz="0.00021"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation / 2} ${-body_height / 2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Sag tekerlek -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00021" ixy="0.0" ixz="0.0"
               iyy="0.000375" iyz="0.0" izz="0.00021"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_separation / 2} ${-body_height / 2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- On destek kuresi. Atalet (kure): 2/5*m*r^2 -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
               iyy="0.000025" iyz="0.0" izz="0.000025"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="${body_length / 2 - caster_radius} 0 ${-body_height / 2 - caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Arka destek kuresi: kutle merkezinin iki destek arasinda kalmasi icin -->
  <link name="rear_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
               iyy="0.000025" iyz="0.0" izz="0.000025"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="${-body_length / 2 + caster_radius} 0 ${-body_height / 2 - caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo diferansiyel surus eklentisi: /cmd_vel hiz komutunu tekerleklere cevirir -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
