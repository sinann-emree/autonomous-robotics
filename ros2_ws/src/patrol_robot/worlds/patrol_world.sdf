<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="empty">
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="10ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  
    <!-- Patrol test odasi: 8 x 6 metre, duvar yuksekligi 1.2 m -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.075 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.15 0.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.15 0.15 1.2</size></box></geometry>
          <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.075 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.15 0.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.15 0.15 1.2</size></box></geometry>
          <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.075 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.15 1.2</size></box></geometry>
          <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.075 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.15 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.15 1.2</size></box></geometry>
          <material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>
</world>
</sdf>
